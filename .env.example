# RTSP to WebRTC/WebSocket Gateway Configuration
PORT=3000
HOST=0.0.0.0
RTSP_URL=rtsp://admin:admin123@192.168.1.100:554/live

# Rate Limiting Presets: strict (30 RPM, 2 conns/IP), standard (120 RPM, 5 conns/IP), relaxed (300 RPM, 20 conns/IP)
RATE_LIMIT_PRESET=standard

# Connection Limits
MAX_WS_CLIENTS_TOTAL=25
MAX_WS_CLIENTS_PER_IP=5

# Dev / Testing Flag
ENABLE_MOCK_STREAM=false
